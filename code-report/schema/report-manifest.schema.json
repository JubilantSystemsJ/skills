{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/code-report/report-manifest.schema.json",
  "title": "Code Report Manifest",
  "type": "object",
  "required": ["schema_version", "report", "product", "sections", "quiz", "validation"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "report": {
      "type": "object",
      "required": ["title", "slug", "scope", "target", "written_at"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "scope": {"type": "string", "enum": ["repo", "focus", "branch", "commit", "change"]},
        "target": {"type": "string", "minLength": 1},
        "commit": {"type": "string"},
        "written_at": {"type": "string", "minLength": 1},
        "audience": {"type": "string"}
      },
      "additionalProperties": true
    },
    "product": {
      "type": "object",
      "required": ["purpose", "boundaries", "outcomes"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "boundaries": {"type": "array", "items": {"type": "string"}},
        "outcomes": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "research": {"type": "array", "items": {"$ref": "#/$defs/research"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "sections": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/section"}
    },
    "flow": {"type": "object", "additionalProperties": true},
    "quiz": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
      },
      "additionalProperties": true
    },
    "validation": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["label", "kind", "location"],
      "properties": {
        "label": {"type": "string"},
        "kind": {"type": "string", "enum": ["code-confirmed", "runtime-confirmed", "documented", "inferred", "unknown", "external"]},
        "location": {"type": "string"},
        "accessed": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["topic", "selected", "rationale"],
      "properties": {
        "topic": {"type": "string"},
        "selected": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string"},
        "section": {"type": "string"}
      },
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": ["topic", "selected_pattern", "rationale"],
      "properties": {
        "topic": {"type": "string"},
        "candidates": {"type": "array", "items": {"type": "string"}},
        "selected_pattern": {"type": "string"},
        "rejected_patterns": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "summary", "body"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "body": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "components": {"type": "array", "items": {"type": "string"}},
        "visual": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "question": {
      "type": "object",
      "required": ["id", "prompt", "type", "options", "correct", "feedback"],
      "properties": {
        "id": {"type": "string"},
        "prompt": {"type": "string"},
        "type": {"type": "string", "enum": ["single", "multi"]},
        "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "correct": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "feedback": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["id", "name", "kind", "role", "receives", "produces", "neighbors", "boundary", "why", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "receives": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "produces": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "neighbors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "boundary": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
